# 后端配置：复制为 .env 后填写（.env 已被 gitignore）

# 模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 数据目录（默认 backend/data）。容器里指向挂载的卷，数据库与上传文件都在这里
DATA_DIR=

# 账号
# 公网部署务必设一个邀请码，否则任何知道地址的人都能注册
REGISTRATION_CODE=
ALLOW_REGISTRATION=true
# 连续登录失败几次后锁定，锁定分钟数。设为 0 关闭这个限制（方便自己调试）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# 走 HTTPS 时设为 true，Cookie 只经加密连接发送
SESSION_COOKIE_SECURE=false
SESSION_DAYS=30

# 上传大小上限（MB）
MAX_UPLOAD_MB=50
